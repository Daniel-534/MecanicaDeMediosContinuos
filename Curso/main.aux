\@writefile{toc}{\contentsline {section}{\numberline {1.4}Fuerzas intermoleculares y estados de la materia}{4}{section.15}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {1.2}{\ignorespaces Potencial de Lennard--Jones en variables adimensionales. A distancias cortas domina el término repulsivo $r^{-12}$; a distancias mayores domina el término atractivo $-r^{-6}$. El mínimo corresponde a la separación molecular de equilibrio.}}{5}{figure.17}\protected@file@percent }
\newlabel{fig:potencial-lennard-jones}{{1.2}{5}{Potencial de Lennard--Jones en variables adimensionales. A distancias cortas domina el término repulsivo $r^{-12}$; a distancias mayores domina el término atractivo $-r^{-6}$. El mínimo corresponde a la separación molecular de equilibrio}{figure.17}{}}
\@writefile{toc}{\contentsline {section}{\numberline {1.5}Materia granular}{6}{section.18}\protected@file@percent }
\@writefile{toc}{\contentsline {section}{\numberline {1.6}Aproximación del continuo}{6}{section.19}\protected@file@percent }
\@writefile{toc}{\contentsline {subsection}{\numberline {1.6.1}Fluctuaciones de densidad}{6}{subsection.20}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {1.3}{\ignorespaces Origen estadístico de las fluctuaciones de densidad. Las moléculas entran y salen aleatoriamente de un volumen de control, haciendo que $N(t)$ y, por tanto, $\rho (t)$ fluctúen alrededor de sus valores medios. Al aumentar $N$, la amplitud relativa de las fluctuaciones decrece como $N^{-1/2}$.}}{7}{figure.22}\protected@file@percent }
\newlabel{fig:fluctuaciones-densidad}{{1.3}{7}{Origen estadístico de las fluctuaciones de densidad. Las moléculas entran y salen aleatoriamente de un volumen de control, haciendo que $N(t)$ y, por tanto, $\rho (t)$ fluctúen alrededor de sus valores medios. Al aumentar $N$, la amplitud relativa de las fluctuaciones decrece como $N^{-1/2}$}{figure.22}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {1.6.2}Suavidad macroscópica}{7}{subsection.23}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {1.4}{\ignorespaces Interpretación multiescala de la suavidad macroscópica. Los promedios de densidad en celdas de tamaño $L_{\mathrm  {micro}}$ cambian muy poco entre vecinos y reconstruyen un campo continuo que varía sobre $L_{\mathrm  {macro}}$. Una interfaz del orden de $L_{\mathrm  {mol}}$ aparece, en cambio, como una discontinuidad.}}{8}{figure.25}\protected@file@percent }
\newlabel{fig:suavidad-macroscopica}{{1.4}{8}{Interpretación multiescala de la suavidad macroscópica. Los promedios de densidad en celdas de tamaño $L_{\mathrm {micro}}$ cambian muy poco entre vecinos y reconstruyen un campo continuo que varía sobre $L_{\mathrm {macro}}$. Una interfaz del orden de $L_{\mathrm {mol}}$ aparece, en cambio, como una discontinuidad}{figure.25}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {1.6.3}Fluctuaciones de velocidad}{8}{subsection.26}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {1.5}{\ignorespaces Origen estadístico de las fluctuaciones de velocidad. Las velocidades moleculares individuales son grandes y aleatorias, mientras que su promedio define la velocidad macroscópica. Al aumentar el número de moléculas del volumen de promedio, la distribución de $v_{\mathrm  {CM}}$ se estrecha como $N^{-1/2}$.}}{9}{figure.28}\protected@file@percent }
\newlabel{fig:fluctuaciones-velocidad}{{1.5}{9}{Origen estadístico de las fluctuaciones de velocidad. Las velocidades moleculares individuales son grandes y aleatorias, mientras que su promedio define la velocidad macroscópica. Al aumentar el número de moléculas del volumen de promedio, la distribución de $v_{\mathrm {CM}}$ se estrecha como $N^{-1/2}$}{figure.28}{}}
\@writefile{toc}{\contentsline {section}{\numberline {1.7}Camino libre medio}{9}{section.29}\protected@file@percent }
\@writefile{toc}{\contentsline {subsection}{\numberline {1.7.1}Definición y contexto físico}{10}{subsection.30}\protected@file@percent }
\@writefile{toc}{\contentsline {subsection}{\numberline {1.7.2}Geometría de las colisiones}{10}{subsection.31}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {1.6}{\ignorespaces Geometría empleada para estimar el camino libre medio. Una molécula barre un cilindro efectivo de sección transversal $\pi d^2$ y recorre, en promedio, una distancia $\lambda $ antes de encontrar otra molécula dentro de la región de colisión.}}{10}{figure.33}\protected@file@percent }
\newlabel{fig:geometria-camino-libre-medio}{{1.6}{10}{Geometría empleada para estimar el camino libre medio. Una molécula barre un cilindro efectivo de sección transversal $\pi d^2$ y recorre, en promedio, una distancia $\lambda $ antes de encontrar otra molécula dentro de la región de colisión}{figure.33}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {1.7.3}Derivación del camino libre medio}{11}{subsection.34}\protected@file@percent }
\@writefile{toc}{\contentsline {subsection}{\numberline {1.7.4}Tiempo medio entre colisiones}{12}{subsection.35}\protected@file@percent }
\@writefile{toc}{\contentsline {subsection}{\numberline {1.7.5}Importancia para la aproximación del continuo}{12}{subsection.36}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {1.7}{\ignorespaces Aumento del camino libre medio con la altitud. Al disminuir la densidad atmosférica, las moléculas se encuentran más separadas y recorren distancias mayores entre colisiones. Cuando $\lambda $ se vuelve comparable con la escala $L$ del sistema, la aproximación del continuo deja de ser adecuada.}}{13}{figure.39}\protected@file@percent }
\newlabel{fig:camino-libre-medio-altitud}{{1.7}{13}{Aumento del camino libre medio con la altitud. Al disminuir la densidad atmosférica, las moléculas se encuentran más separadas y recorren distancias mayores entre colisiones. Cuando $\lambda $ se vuelve comparable con la escala $L$ del sistema, la aproximación del continuo deja de ser adecuada}{figure.39}{}}
